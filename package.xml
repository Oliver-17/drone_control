<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_control</name>
  <version>0.1.0</version>
  <description>PX4 v1.14 Offboard 控制節點：單機起飛、懸停、降落（可擴充為多機編隊）</description>

  <maintainer email="oliver.920906@gmail.com">oliver</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rclcpp: ROS 2 的 C++ 客戶端函式庫 -->
  <depend>rclcpp</depend>
  <!-- px4_msgs: PX4 的訊息定義，必須和 PX4 韌體版本對齊（這裡是 release/1.14） -->
  <depend>px4_msgs</depend>

  <!-- 以下為 px4_tf_node / cmd_vel_to_px4_node 用（PX4 <-> ROS 的雙向座標翻譯） -->
  <!-- geometry_msgs: Twist（Nav2 的速度指令）與 TransformStamped -->
  <depend>geometry_msgs</depend>
  <!-- tf2 系列: 四元數運算與 TF 廣播。座標轉換一律交給它，不手刻旋轉矩陣 -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Nav2：S4 起用到 costmap 與 map_server。只在執行期需要，編譯不需要 -->
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <!-- 靜態地圖與 Nav2 參數來自場地包。
       方向是「節點包依賴資料包」，反過來不行 ——
       否則同學只想拿場地卻被迫連飛控程式一起裝。 -->
  <exec_depend>drone_nav2_apriltag</exec_depend>

  <!-- Python 端（arm_and_takeoff.py、mission_node.py、test/*.py）用。
       之前沒宣告是漏的 —— 能跑是因為 rclpy 本來就裝在系統裡。 -->
  <exec_depend>rclpy</exec_depend>
  <!-- action_msgs: mission_node 要讀 GoalStatus 判斷 action 成功與否。
       Humble 的 NavigateToPose.Result 是 std_msgs/Empty，裡面沒有錯誤碼，
       成功失敗只能看 goal 的 status，所以這個相依是必要的。 -->
  <exec_depend>action_msgs</exec_depend>

  <!-- ⚠️ 刻意「不」宣告 drone_apriltag_landing。
       mission_node 對 PrecisionLand 是延後 import 的，沒裝那個套件時
       用 land:=false 照樣能跑「導航到某個節點」。宣告成相依的話，
       只想要橋接節點的人會被迫連降落包一起裝 ——
       跟上面「節點包依賴資料包、反過來不行」是同一個原則。 -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
